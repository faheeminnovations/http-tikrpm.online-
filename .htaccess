# ============================================================
#  TikRPM.com — Apache .htaccess
#  Clean URLs, security headers, performance
#  NOTE: RewriteBase set to /tikrpm/ for local XAMPP dev.
#  Change to / when deploying to production root domain.
# ============================================================

Options -Indexes
Options -MultiViews

# ── Engine On ────────────────────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /tikrpm/

  # ── Force HTTPS (disable on local, enable on production) ───
  # RewriteCond %{HTTPS} off
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # ── Remove www (canonical) ─────────────────────────────────
  # RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  # RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # ── Let real files and directories pass through first ───────
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # ── Remove .php extension from URL (301 redirect) ──────────
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+tikrpm/(.+)\.php[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # ── Blog post: /blog/{slug} → single-blog.php?slug={slug} ──
  RewriteRule ^blog/([a-z0-9\-]+)/?$ single-blog.php?slug=$1 [L,QSA]

  # ── Internally rewrite clean URL → .php file ───────────────
  RewriteCond %{REQUEST_FILENAME}.php -f
  RewriteRule ^([^.]+?)/?$ $1.php [L]

  # ── Block access to sensitive files ────────────────────────
  RewriteRule ^(includes|vendor|admin/auth\.php|admin/partials|database|composer\.json|composer\.lock|\.git|\.env)(/|$) - [F,L]
</IfModule>

# ── Security Headers ─────────────────────────────────────────
<IfModule mod_headers.c>
  # Prevent MIME-type sniffing
  Header always set X-Content-Type-Options "nosniff"

  # Clickjacking protection
  Header always set X-Frame-Options "SAMEORIGIN"

  # XSS filter (legacy browsers)
  Header always set X-XSS-Protection "1; mode=block"

  # Referrer policy
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Permissions policy (disable unnecessary browser features)
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

  # HSTS — enable only after confirmed HTTPS is working
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

  # Content Security Policy — adjust as needed for AdSense/GA
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://pagead2.googlesyndication.com https://www.googletagmanager.com https://www.google-analytics.com https://fonts.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; frame-src https://googleads.g.doubleclick.net https://tpc.googlesyndication.com; connect-src 'self' https://www.google-analytics.com;"

  # Remove server signature
  Header unset Server
  Header unset X-Powered-By
</IfModule>

# ── Hide PHP version ─────────────────────────────────────────
<IfModule mod_php.c>
  php_flag expose_php Off
</IfModule>

# ── Block direct access to includes/ ─────────────────────────
<FilesMatch "^(config|header|footer)\.php$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# ── Protect dot-files (.env, .git, etc.) ─────────────────────
<FilesMatch "^\.">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# ── Compression ──────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml
  AddOutputFilterByType DEFLATE text/css application/javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ── Browser Caching ──────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                          "access plus 1 month"

  # HTML — short cache (content changes)
  ExpiresByType text/html                 "access plus 1 hour"

  # CSS / JS — versioned via ?v= query string in prod
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"

  # Images
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType image/x-icon              "access plus 1 year"

  # Fonts
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType font/woff                 "access plus 1 year"
</IfModule>

# ── Cache-Control Headers ────────────────────────────────────
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2?|ttf|eot|svg|ico|png|jpg|jpeg|webp|gif)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(php|html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# ── Custom Error Pages ───────────────────────────────────────
ErrorDocument 404 /404.php
ErrorDocument 403 /403.php
ErrorDocument 500 /500.php

# ── Disable ETag (avoid duplicate caching headers) ───────────
FileETag None
<IfModule mod_headers.c>
  Header unset ETag
</IfModule>
